LIFEKERNEL_CONFIG=./lifekernel.config.json
# Static bearer token for trusted clients (24+ characters). Optional when OAuth is enabled.
LIFEKERNEL_API_TOKEN=replace-with-a-long-random-token
# Enable OAuth for ChatGPT and Claude.ai: the public HTTPS origin and an owner passphrase (20+ characters).
LIFEKERNEL_PUBLIC_URL=https://memory.example.com
LIFEKERNEL_OWNER_SECRET=replace-with-a-long-random-passphrase
LIFEKERNEL_HOST=127.0.0.1
LIFEKERNEL_PORT=8787
LIFEKERNEL_ALLOWED_ORIGINS=https://memory.example.com
# Ritual reminders (see docs/notifications.md). The ntfy topic is a secret: anyone who knows it can read it.
LIFEKERNEL_NTFY_TOPIC=replace-with-a-long-random-topic
# LIFEKERNEL_NTFY_URL=https://ntfy.sh
# LIFEKERNEL_NTFY_TOKEN=
# LIFEKERNEL_WEBHOOK_URL=
# LIFEKERNEL_WEBHOOK_SECRET=
# Telegram bot from @BotFather, and your chat ID from `lifekernel telegram setup`.
# LIFEKERNEL_TELEGRAM_TOKEN=
# LIFEKERNEL_TELEGRAM_CHAT_ID=
# Email: smtps://user:password@mail.example.com (or smtp:// with STARTTLS).
# LIFEKERNEL_SMTP_URL=
# LIFEKERNEL_EMAIL_FROM=
# LIFEKERNEL_EMAIL_TO=
# A token that can only add to the inbox (24+ characters), for phone shortcuts.
# LIFEKERNEL_CAPTURE_TOKEN=
# Optional key for signed snooze and skip links (32+ characters); otherwise one is generated in the state directory.
# LIFEKERNEL_ACTION_SECRET=
# Run the reminder check inside the HTTP server (Docker and remote mode).
LIFEKERNEL_SCHEDULER=off
# Read-only calendar feed at /v1/rituals.ics?token=... (24+ characters, different from the API token).
# LIFEKERNEL_CALENDAR_TOKEN=
